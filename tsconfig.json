{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "drizzle.config.ts", "vite.config.ts", "vitest.config.ts", "camunda-config/**/*", "drop-schema.ts", "seed_customer.ts"]
}
