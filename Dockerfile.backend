ARG NODE_VERSION=22
ARG PNPM_VERSION=10.0.0

# ============================================================================
# STAGE 1: BASE — Minimal dependencies
# ============================================================================
FROM node:${NODE_VERSION}-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apk add --no-cache git python3 make g++ && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages ./packages

# ============================================================================
# STAGE 2: BUILD — Full compilation with dev dependencies
# ============================================================================
FROM base AS build

ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source files and build
COPY tsconfig.base.json tsconfig.json ./
COPY src ./src
COPY drizzle ./drizzle

RUN pnpm run build && \
    rm -rf .turbo && \
    rm -rf src tests vitest.config.ts

# ============================================================================
# STAGE 3: PRODUCTION DEPENDENCIES — Runtime-only packages
# ============================================================================
FROM base AS prod-deps

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --no-scripts && \
    pnpm exec npm rebuild --production 2>/dev/null || true

# ============================================================================
# STAGE 4: PRODUCTION — Chainguard hardened Node.js image
# ============================================================================
FROM cgr.dev/chainguard/node:latest AS production

ENV NODE_ENV="production"
ENV NODE_OPTIONS="--max-old-space-size=2048"

WORKDIR /app

# Copy production dependencies with explicit ownership
COPY --chown=nonroot:nonroot --from=prod-deps /app/node_modules /app/node_modules
COPY --chown=nonroot:nonroot --from=build /app/packages /app/packages
COPY --chown=nonroot:nonroot --from=build /app/src /app/src
COPY --chown=nonroot:nonroot --from=build /app/drizzle /app/drizzle

# Create data directory for SQLite
RUN mkdir -p /app/data && chown nonroot:nonroot /app/data

# Only copy necessary manifests
COPY --chown=nonroot:nonroot pnpm-lock.yaml package.json ./

EXPOSE 3001

# Healthcheck using native Node
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
    CMD ["/usr/bin/node", "-e", "fetch('http://localhost:3001/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["--import", "tsx/esm", "src/server.ts"]

# ============================================================================
# STAGE 5: DEVELOPMENT — Hot-reload with full tooling
# ============================================================================
FROM base AS development

ENV NODE_ENV="development"
ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY tsconfig.base.json tsconfig.json ./
COPY src ./src
COPY drizzle ./drizzle

RUN mkdir -p /app/data

EXPOSE 3001

# Watch mode with hot-reload
CMD ["tsx", "watch", "src/server.ts"]
