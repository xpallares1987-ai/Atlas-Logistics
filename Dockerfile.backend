ARG NODE_VERSION=22
ARG PNPM_VERSION=10.0.0

# Base stage: pnpm + workspace manifests
FROM node:${NODE_VERSION}-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN apk add --no-cache git && corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY src ./src

# Prod-deps stage: only production dependencies (no devDependencies)
FROM base AS prod-deps
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --prod --ignore-scripts

# Build stage: full dependencies to compile/build
FROM base AS build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install
RUN pnpm run build

# Production Stage (Chainguard Hardened) — only prod deps + source
FROM cgr.dev/chainguard/node:latest AS production
WORKDIR /app

COPY --chown=nonroot:nonroot --from=prod-deps /app/node_modules /app/node_modules
COPY --chown=nonroot:nonroot --from=build /app/src /app/src
COPY --chown=nonroot:nonroot --from=build /app/package.json /app/package.json

EXPOSE 8080
CMD ["--import", "tsx/esm", "src/server.ts"]
