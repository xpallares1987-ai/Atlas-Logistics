ARG NODE_VERSION=22
ARG PNPM_VERSION=11.5.1

# ============================================================================
# STAGE 1: BASE — Minimal dependencies with pnpm setup
# ============================================================================
FROM node:${NODE_VERSION}-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV HUSKY=0
ENV CI=true

RUN apk add --no-cache git python3 make g++ && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages ./packages

# ============================================================================
# STAGE 2: DEPENDENCIES — Install all dependencies (for both dev & prod)
# ============================================================================
FROM base AS dependencies

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts

# ============================================================================
# STAGE 3: DEVELOPMENT — Hot-reload with volumes
# ============================================================================
FROM dependencies AS development

ENV NODE_ENV="development"
ENV NODE_OPTIONS="--max-old-space-size=1024 --enable-source-maps"
ENV LOG_LEVEL="debug"

WORKDIR /app

# Dependencies already cached from previous stage
COPY src ./src
COPY drizzle ./drizzle
COPY package.json pnpm-lock.yaml tsconfig*.json ./

# Create data directory for SQLite
RUN mkdir -p /app/data && chmod 777 /app/data

EXPOSE 3001

# Healthcheck for dev environment
HEALTHCHECK --interval=15s --timeout=10s --retries=3 --start-period=15s \
    CMD ["/bin/sh", "-c", "node -e \"fetch('http://localhost:3001/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\" || exit 1"]

# Watch mode with tsx for fast reloads
CMD ["pnpm", "start:backend"]

# ============================================================================
# STAGE 4: PRODUCTION DEPENDENCIES — Install only runtime deps
# ============================================================================
FROM base AS prod-deps

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --ignore-scripts

# ============================================================================
# STAGE 5: PRODUCTION — Lightweight Fastify runtime
# ============================================================================
FROM node:${NODE_VERSION}-alpine AS production

ENV NODE_ENV="production"
ENV NODE_OPTIONS="--max-old-space-size=2048"

WORKDIR /app

# Copy production node_modules and packages with pre-built artifacts
COPY --from=prod-deps /app/node_modules /app/node_modules
COPY --from=prod-deps /app/packages /app/packages
COPY src ./src
COPY drizzle ./drizzle
COPY package.json pnpm-lock.yaml ./

# Create data directory for SQLite (production use)
RUN mkdir -p /app/data && chmod 755 /app/data

# Run as non-root for security (create node user with home dir)
RUN addgroup -g 1000 node && \
    adduser -D -u 1000 -G node node && \
    chown -R node:node /app

USER node

EXPOSE 3001

# Production healthcheck
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
    CMD ["/bin/sh", "-c", "node -e \"fetch('http://localhost:3001/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\" || exit 1"]

CMD ["node", "--import", "tsx/esm", "src/server.ts"]
