ARG NODE_VERSION=22
ARG PNPM_VERSION=10.0.0

# ============================================================================
# STAGE 1: BASE — Workspace initialization
# ============================================================================
FROM node:${NODE_VERSION}-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN apk add --no-cache git && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages

# ============================================================================
# STAGE 2: BUILD — Full dependencies + compilation
# ============================================================================
FROM base AS build

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install

# Copy source and build
COPY src ./src
COPY drizzle ./drizzle
RUN mkdir -p /app/data

RUN pnpm run build && rm -rf .turbo

# ============================================================================
# STAGE 3: PRODUCTION — Chainguard hardened Node.js image
# ============================================================================
FROM cgr.dev/chainguard/node:latest AS production

ENV NODE_ENV="production"
ENV NODE_OPTIONS="--max-old-space-size=4096"

WORKDIR /app

# Copy minimal production dependencies and compiled artifacts
COPY --chown=nonroot:nonroot --from=build /app/node_modules /app/node_modules
COPY --chown=nonroot:nonroot --from=build /app/src /app/src
COPY --chown=nonroot:nonroot --from=build /app/drizzle /app/drizzle
COPY --chown=nonroot:nonroot --from=build /app/data /app/data
COPY --chown=nonroot:nonroot --from=build /app/packages /app/packages
COPY --chown=nonroot:nonroot --from=build /app/pnpm-lock.yaml /app/pnpm-lock.yaml
COPY --chown=nonroot:nonroot --from=build /app/package.json /app/package.json

EXPOSE 3001

# Healthcheck using native Node
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=30s \
    CMD ["/usr/bin/node", "-e", "fetch('http://localhost:3001/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["--import", "tsx/esm", "src/server.ts"]

# ============================================================================
# STAGE 4: DEVELOPMENT — Hot-reload enabled, full tooling
# ============================================================================
FROM base AS development

ENV NODE_ENV="development"

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install

COPY src ./src
COPY drizzle ./drizzle
RUN mkdir -p /app/data

EXPOSE 3001

# Watch mode for hot-reload
CMD ["tsx", "watch", "src/server.ts"]
