# ==============================================================================
# ATLAS LOGISTICS — LOCAL DEVELOPMENT ENVIRONMENT (.env.local)
# ==============================================================================
# COPY THIS FILE: cp .env.local.example .env.local
# NEVER commit real secrets to git. This file is for LOCAL DEVELOPMENT ONLY.
#
# Security Note: Store production secrets in Docker Secrets, Vault, or similar.
# ==============================================================================

# Database: SQLite (local development default)
NODE_ENV=development
DATABASE_URL=file:./atlas-erp-v2.db

# Redis: Local container (started via `pnpm dev`)
REDIS_HOST=redis
REDIS_PORT=6379
# Leave empty for local dev; set only if using external Redis

# API & Frontend Ports
BACKEND_PORT=3001
VITE_PORT=5173
PORT=3000

# Authentication (Development placeholders only — use strong values locally!)
JWT_SECRET=your-jwt-secret-dev-only-change-this
COOKIE_SECRET=your-cookie-secret-dev-only-change-this

# Google Cloud / Firebase (Optional: Only if using GCP services)
# GOOGLE_CLOUD_PROJECT=atlas-logistics-dev
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json
# FIREBASE_TOKEN=your-firebase-token
# GEMINI_API_KEY=your-gemini-api-key

# Observability (Optional: Only when using --profile observability)
GRAFANA_ADMIN_PASSWORD=atlas2024
PROMETHEUS_RETENTION=15d

# GitHub / Turbo (Optional: Only for CI/CD integration)
# GH_PAT=your-github-pat
# TURBO_TOKEN=your-turbo-token
# TURBO_TEAM=your-turbo-team

# ==============================================================================
# PRODUCTION ENVIRONMENT NOTES:
# ==============================================================================
# For production, create .env.production with:
# - NODE_ENV=production
# - DATABASE_URL=file:./atlas-erp-prod.db (or remote libsql://...)
# - Strong JWT_SECRET and COOKIE_SECRET
# - All optional services (Grafana, Prometheus) preconfigured
# - Secrets stored in Docker Secrets or a secrets manager
# ==============================================================================
