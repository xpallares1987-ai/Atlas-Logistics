{
  "version": "1.0",
  "hooks": [
    {
      "id": "atlas-session-safety",
      "event": "SessionStart",
      "command": "python ./.github/hooks/atlas_agent_guard.py --event SessionStart"
    },
    {
      "id": "atlas-pretool-safety",
      "event": "PreToolUse",
      "command": "python ./.github/hooks/atlas_agent_guard.py --event PreToolUse --tool-command \"${toolCommand}\""
    }
  ]
}
