{
  "schemaVersion": 10,
  "exporter": {
    "name": "Atlas Logistics — Sea Modeler (Customer01 Suite)",
    "version": "5.0"
  },
  "type": "default",
  "id": "Customer01_instruccion_embarque_form",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.2.0",
  "components": [
    {
      "text": "## 📄 Shipping Instructions (SI) / Emisión de B/L\n**Embarcador:** Customer01 Paper — Exportación FCL Containerboard\n*Datos finales para la emisión del Conocimiento de Embarque Marítimo ante la naviera.*",
      "type": "text",
      "id": "Header_SI"
    },
    {
      "label": "Referencia de Booking Naviera",
      "type": "textfield",
      "id": "booking_reference",
      "key": "booking_reference",
      "validate": { "required": true }
    },
    {
      "label": "Shipper / Exportador",
      "type": "textfield",
      "id": "shipper_cargador",
      "key": "shipper_cargador",
      "defaultValue": "SOCIEDAD ANONIMA INDUSTRIAS CELULOSA ARAGONESA (Customer01) - San Juan de la Peña 144, 50015 Zaragoza",
      "validate": { "required": true }
    },
    {
      "label": "Consignee / Destinatario",
      "type": "textfield",
      "id": "consignatario_notify",
      "key": "consignatario_notify",
      "description": "Cliente o planta de packaging en destino",
      "validate": { "required": true }
    },
    {
      "label": "Matrícula Contenedor y Precinto ISO 17712",
      "type": "textfield",
      "id": "numero_contenedor_precinto",
      "key": "numero_contenedor_precinto",
      "description": "Ej: MSCU7654321 / Precinto: ES-MSC-998877",
      "validate": { "required": true }
    },
    {
      "label": "Masa Bruta Verificada VGM Certificada (kg)",
      "type": "number",
      "id": "peso_bruto_vgm_kg",
      "key": "peso_bruto_vgm_kg",
      "description": "Peso total báscula (tara + mercancía + trincaje)",
      "validate": { "required": true }
    },
    {
      "label": "Descripción Oficial de Mercancía en B/L",
      "type": "textfield",
      "id": "descripcion_mercancia",
      "key": "descripcion_mercancia",
      "defaultValue": "REELS OF CONTAINERBOARD (KRAFTLINER / TESTLINER / FLUTING) FOR PACKAGING",
      "validate": { "required": true }
    },
    {
      "label": "Posición Arancelaria HS / TARIC",
      "type": "textfield",
      "id": "partida_arancelaria",
      "key": "partida_arancelaria",
      "defaultValue": "4805.11.00 / 4805.19.00 / 4804.11.00"
    },
    {
      "label": "Tipo de B/L Requerido",
      "type": "select",
      "id": "tipo_bl_solicitado",
      "key": "tipo_bl_solicitado",
      "values": [
        { "label": "Sea Waybill / Express Release (Sin originales físicos)", "value": "SeaWaybill" },
        { "label": "Original B/L (Juego 3/3 Negociable)", "value": "Original_3_3" },
        { "label": "Telex Release / Surrender B/L", "value": "TelexRelease" }
      ],
      "validate": { "required": true }
    },
    {
      "label": "Cláusulas Especiales de Estiba y Trincaje",
      "type": "textarea",
      "id": "clausulas_adicionales",
      "key": "clausulas_adicionales",
      "defaultValue": "Clean On Board. Shipper's load, stow, count and weight. Cargo properly chocked with ISPM-15 treated wood and desiccant bags."
    }
  ]
}

