# ==============================================================================
# ATLAS LOGISTICS — PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy to .env.production and populate with actual secrets.
# NEVER commit .env.production to Git.
#
# ==============================================================================

# Node Environment
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=2048
LOG_LEVEL=info

# ==============================================================================
# Database (SQLite in WAL Mode / libSQL)
# ==============================================================================
# For local / Docker Compose production:
DATABASE_URL=file:/app/data/prod.db
# For managed distributed libSQL / Turso cloud (optional):
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# ==============================================================================
# Redis (Message Queue, Cache, Sessions)
# ==============================================================================
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=${JWT_SECRET}
COOKIE_SECRET=${COOKIE_SECRET}
JWT_EXPIRY=7d

# ==============================================================================
# API & Frontend Configuration
# ==============================================================================
VITE_API_URL=https://api.example.com
API_BASE_URL=https://api.example.com
VITE_PUBLIC_API_URL=https://api.example.com

# ==============================================================================
# Workers & Background Jobs
# ==============================================================================
ENABLE_WORKERS=true
WORKER_CONCURRENCY=10
WORKER_MAX_ATTEMPTS=3

# ==============================================================================
# External Services (Optional)
# ==============================================================================
# GEMINI_API_KEY=${GEMINI_API_KEY}

# ==============================================================================
# Observability, Grafana Cloud Prometheus & Grafana Assistant
# ==============================================================================
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
GRAFANA_ROOT_URL=https://grafana.example.com

# Grafana Cloud Hosted Prometheus (cheerfulmole1135-prom / prod-eu-west-2)
GRAFANA_CLOUD_PROM_INSTANCE=cheerfulmole1135-prom
GRAFANA_CLOUD_PROM_QUERY_URL=https://prometheus-prod-72-prod-eu-west-4.grafana.net/api/prom
GRAFANA_CLOUD_PROM_REMOTE_WRITE_URL=https://prometheus-prod-72-prod-eu-west-4.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=3759940
GRAFANA_CLOUD_PROM_TOKEN=${GRAFANA_CLOUD_PROM_TOKEN}

# Grafana Assistant Plugin Configuration (Stack 1917865 / prod-eu-west-2)
GRAFANA_ASSISTANT_URL=https://assistant-prod-eu-west-2.grafana.net/assistant
GRAFANA_ASSISTANT_INSTANCE_ID=1917865
GRAFANA_ASSISTANT_TOKEN=${GRAFANA_ASSISTANT_TOKEN}
