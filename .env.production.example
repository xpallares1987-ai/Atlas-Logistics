# ==============================================================================
# ATLAS-LOGISTICS - PRODUCTION ENVIRONMENT VARIABLES (.env.production)
# ==============================================================================
# Copie este archivo a .env.production en su servidor de producción.

NODE_ENV=production
PORT=3000
BACKEND_PORT=3001

# 1. Base de Datos de Producción (SQLite Local o libSQL Remoto)
# Opción A: Archivo SQLite dedicado de producción (por defecto: file:atlas-erp-prod.db)
DATABASE_URL=file:atlas-erp-prod.db

# Opción B: Ruta absoluta en disco persistente o volumen Docker
# DATABASE_URL=file:/var/data/atlas-erp-production.db

# Opción C: Cluster Turso / libSQL remoto gestionado
# DATABASE_URL=libsql://atlas-prod-org.turso.io
# DATABASE_AUTH_TOKEN=your-production-database-auth-token

# 2. Seguridad y JWT
JWT_SECRET=your-production-jwt-secret-super-secure-key-random
# Store this value in your deployment secret manager; never use "admin".
ADMIN_PASSWORD=

# 3. Redis de Producción (BullMQ Workers)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
