# ==============================================================================
# ATLAS LOGISTICS — PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy to .env.production and populate with actual secrets.
# NEVER commit .env.production to Git.
#
# ==============================================================================

# Node Environment
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=2048
LOG_LEVEL=info

# ==============================================================================
# Database
# ==============================================================================
# For development: SQLite (file://./data/dev.db)
# For production: PostgreSQL (postgresql://user:password@host:5432/atlas)
DATABASE_URL=postgresql://user:${POSTGRES_PASSWORD}@postgres:5432/atlas

# ==============================================================================
# Redis (Message Queue, Cache, Sessions)
# ==============================================================================
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY=7d

# ==============================================================================
# API Configuration
# ==============================================================================
# Frontend SPA API endpoint (used in nginx.conf for reverse proxy)
VITE_API_URL=https://api.example.com
API_BASE_URL=https://api.example.com

# ==============================================================================
# Frontend Configuration
# ==============================================================================
# Public API endpoint for browser requests
VITE_PUBLIC_API_URL=https://api.example.com

# ==============================================================================
# Workers & Background Jobs
# ==============================================================================
ENABLE_WORKERS=true
WORKER_CONCURRENCY=10
WORKER_MAX_ATTEMPTS=3

# ==============================================================================
# Email (if applicable)
# ==============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=password
# SMTP_FROM=noreply@example.com

# ==============================================================================
# External Services (if applicable)
# ==============================================================================
# Google GenAI
# GOOGLE_GENAI_API_KEY=${GOOGLE_GENAI_API_KEY}

# AWS / S3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
# AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
# AWS_S3_BUCKET=atlas-documents

# ==============================================================================
# Observability & Monitoring
# ==============================================================================
# Prometheus metrics enabled (backend exposes /metrics)
PROMETHEUS_ENABLED=true

# Sentry error tracking (optional)
# SENTRY_DSN=https://xxx@sentry.io/123456

# ==============================================================================
# Docker Compose Specific (Observability Profile)
# ==============================================================================
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
GRAFANA_ROOT_URL=https://grafana.example.com

# PostgreSQL credentials (for docker-compose.prod.yml)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=atlas

# Redis password (if required)
REDIS_PASSWORD=
