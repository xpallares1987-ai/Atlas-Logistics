{
  "name": "atlas-logistics",
  "version": "1.0.0",
  "description": "SCM Freight Forwarding MVP",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm run eslint",
    "test": "pnpm --filter @atlas/shared test",
    "type-check": "pnpm --filter @atlas/frontend type-check",
    "eslint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "sh .devcontainer/reset-db.sh",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset-and-seed": "sh .devcontainer/reset-db.sh && tsx src/db/seed.ts",
    "start:backend": "tsx --env-file=.env.local src/server.ts | pino-pretty",
    "start:worker": "tsx --env-file=.env.local src/worker-node.ts | pino-pretty",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@atlas/shared": "workspace:^",
    "@bull-board/api": "^8.3.0",
    "@bull-board/fastify": "^8.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@google/genai": "^2.15.0",
    "@libsql/client": "^0.17.4",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "bpmn-auto-layout": "^1.3.0",
    "bullmq": "^5.81.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "lucia": "^3.2.2",
    "node-cache": "^5.1.2",
    "oslo": "^1.2.1",
    "p-limit": "^7.3.1",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "tsx": "^4.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@faker-js/faker": "^10.5.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "^1.62.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.1.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "cross-fetch": "^4.1.0",
    "d3-color": "^3.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-workspaces": "^0.12.1",
    "fast-uri": "^4.1.0",
    "husky": "^9.1.7",
    "i18next": "^26.3.6",
    "lint-staged": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "semantic-release": "^25.0.8",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "uuid": "^11.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.9",
      "react-router": "^8.3.0",
      "valibot": "^1.4.2",
      "uuid": "^14.0.0",
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-14257",
        "GHSA-mh99-v99m-4gvg",
        "GHSA-qwww-vcr4-c8h2"
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
