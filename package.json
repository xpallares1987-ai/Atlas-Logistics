{
  "name": "atlas-logistics",
  "version": "1.0.0",
  "description": "Atlas Logistics Monorepo",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"REDIS,BACKEND,MFE\" -c \"red,cyan,magenta\" \"docker compose up redis --remove-orphans\" \"pnpm run start:backend\" \"wait-on http://127.0.0.1:3001/health -t 30000 && turbo run dev\"",
    "dev:minimal": "concurrently -k -p \"[{name}]\" -n \"BACKEND,MFE\" -c \"cyan,magenta\" \"pnpm run start:backend\" \"wait-on http://127.0.0.1:3001/health -t 30000 && turbo run dev\"",
    "dev:observability": "concurrently -k -p \"[{name}]\" -n \"REDIS,BACKEND,MFE,OBS\" -c \"red,cyan,magenta,yellow\" \"docker compose up redis --remove-orphans\" \"pnpm run start:backend\" \"wait-on http://127.0.0.1:3001/health -t 30000 && turbo run dev\" \"docker compose --profile observability up prometheus grafana node-exporter\"",
    "dev:stop": "docker compose down",
    "dev:dashboard": "pnpm --filter @atlas/dashboard dev",
    "dev:redis:only": "docker compose up redis --remove-orphans",
    "dev:redis:stop": "docker compose stop redis",
    "db:start": "tsx watch src/server.ts",
    "db:studio": "drizzle-kit studio",
    "db:inspect": "drizzle-kit studio",
    "db:ui": "drizzle-kit studio",
    "build": "turbo run build",
    "lint": "pnpm run eslint",
    "test": "vitest run --fileParallelism=false",
    "test:coverage": "vitest run --coverage",
    "test:concurrency": "vitest run tests/concurrency/sqlite-wal-stress.test.ts",
    "type-check": "tsc --noEmit && pnpm --filter @atlas/frontend type-check",
    "type-check:backend": "tsc --noEmit",
    "eslint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "cross-env NODE_ENV=production tsx src/db/migrate.ts",
    "db:reset": "sh .devcontainer/reset-db.sh",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:phase1": "tsx src/db/seed-phases.ts --phase=1",
    "db:seed:phase2": "tsx src/db/seed-phases.ts --phase=2",
    "db:seed:phase3": "tsx src/db/seed-phases.ts --phase=3",
    "db:seed:all": "tsx src/db/seed-phases.ts --phase=all",
    "db:seed:prod": "cross-env NODE_ENV=production tsx src/db/seed.ts",
    "db:reset-and-seed": "sh .devcontainer/reset-db.sh && tsx src/db/seed.ts",
    "start": "cross-env NODE_ENV=production tsx src/server.ts",
    "start:prod": "cross-env NODE_ENV=production tsx src/server.ts",
    "start:backend": "tsx watch src/server.ts",
    "start:worker": "tsx src/worker-node.ts",
    "test:e2e": "playwright test",
    "admin:create": "tsx src/admin/cli.ts",
    "clean:cache": "rm -rf .turbo .njsscan",
    "clean:cache:gha": "node scripts/maintenance/ci-clean.mjs",
    "clean:documents": "tsx src/scripts/documents-garbage-collector.ts",
    "backup-db": "node src/scripts/backup-db.js",
    "verify:env": "node scripts/verify-env.js",
    "audit:leaks": "node scripts/check-sensitive-leaks.cjs --all",
    "audit:leaks:staged": "node scripts/check-sensitive-leaks.cjs --staged",
    "audit:ddl-drift": "node scripts/check-ddl-drift.mjs",
    "audit:legacy-docs": "node scripts/check-legacy-docs.mjs",
    "audit:links": "node scripts/check-markdown-links.mjs",
    "audit:innerhtml": "node scripts/check-zero-innerhtml.mjs",
    "audit:naming": "node scripts/check-naming-conventions.mjs",
    "test:backup-restore": "node scripts/test-sqlite-backup-restore.mjs",
    "check:file-sizes": "node scripts/check-file-sizes.mjs",
    "wiki:sync": "node scripts/sync-wiki.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:generate:api": "node scripts/generate-docs.mjs --api",
    "docs:generate:cli": "node scripts/generate-docs.mjs --cli",
    "docs:generate:all": "node scripts/generate-docs.mjs --all",
    "docs:generate:frontend": "node scripts/generate-docs.mjs --frontend",
    "docs:generate:backend": "node scripts/generate-docs.mjs --backend",
    "docs:generate:worker": "node scripts/generate-docs.mjs --worker",
    "docs:generate:observability": "node scripts/generate-docs.mjs --observability",
    "docs:generate:analytics": "node scripts/generate-docs.mjs --analytics",
    "docs:generate:notifications": "node scripts/generate-docs.mjs --notifications",
    "docs:generate:shipments": "node scripts/generate-docs.mjs --shipments",
    "docs:generate:inventory": "node scripts/generate-docs.mjs --inventory",
    "docs:generate:finance": "node scripts/generate-docs.mjs --finance",
    "docs:generate:operations": "node scripts/generate-docs.mjs --operations",
    "docs:generate:customs": "node scripts/generate-docs.mjs --customs",
    "docs:generate:warehouse": "node scripts/generate-docs.mjs --warehouse",
    "docs:generate:transport": "node scripts/generate-docs.mjs --transport",
    "docs:generate:partners": "node scripts/generate-docs.mjs --partners",
    "docs:generate:reports": "node scripts/generate-docs.mjs --reports",
    "docs:generate:settings": "node scripts/generate-docs.mjs --settings",
    "docs:generate:dashboard": "node scripts/generate-docs.mjs --dashboard",
    "docs:generate:analytics-dashboard": "node scripts/generate-docs.mjs --analytics-dashboard",
    "docs:generate:notifications-dashboard": "node scripts/generate-docs.mjs --notifications-dashboard",
    "docs:generate:shipments-dashboard": "node scripts/generate-docs.mjs --shipments-dashboard",
    "docs:generate:inventory-dashboard": "node scripts/generate-docs.mjs --inventory-dashboard",
    "docs:generate:finance-dashboard": "node scripts/generate-docs.mjs --finance-dashboard",
    "docs:generate:operations-dashboard": "node scripts/generate-docs.mjs --operations-dashboard",
    "docs:generate:customs-dashboard": "node scripts/generate-docs.mjs --customs-dashboard",
    "docs:generate:warehouse-dashboard": "node scripts/generate-docs.mjs --warehouse-dashboard",
    "docs:generate:transport-dashboard": "node scripts/generate-docs.mjs --transport-dashboard",
    "docs:generate:partners-dashboard": "node scripts/generate-docs.mjs --partners-dashboard",
    "docs:generate:reports-dashboard": "node scripts/generate-docs.mjs --reports-dashboard",
    "docs:generate:settings-dashboard": "node scripts/generate-docs.mjs --settings-dashboard"
  },
  "dependencies": {
    "@atlas/shared": "workspace:^",
    "@bull-board/api": "^9.13.0",
    "@bull-board/fastify": "^9.13.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/redis": "^9.0.1",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/websocket": "^11.3.7",
    "@google/genai": "^3.2.0",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api": "^1.10.0",
    "@prometheus-io/client": "^0.16.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^6.7.4",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "fastify-metrics": "^15.0.1",
    "ioredis": "^6.0.0",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react-compiler-runtime": "^1.0.0",
    "sax": "^1.6.1",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@faker-js/faker": "^10.6.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@originjs/vite-plugin-federation": "^1.3.8",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sax": "^1.2.7",
    "@types/supertest": "^7.2.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "cross-fetch": "^4.1.0",
    "d3-color": "^3.1.1",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-workspaces": "^0.12.1",
    "fast-uri": "^4.2.3",
    "husky": "^9.1.7",
    "i18next": "^27.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "react-i18next": "^18.0.1",
    "semantic-release": "^25.0.8",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "uuid": "^14.0.3",
    "vite": "^8.3.8",
    "vite-plugin-devtools-json": "^1.1.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "brace-expansion": ">=5.0.12",
    "react-router": "^8.3.0",
    "valibot": "^1.4.2",
    "uuid": "^14.0.3",
    "esbuild": "^0.25.0",
    "nanoid": ">=3.3.17",
    "js-yaml": ">=5.4.1",
    "dompurify": ">=3.4.16",
    "undici": ">=7.29.1",
    "fast-uri": ">=4.2.3",
    "qs": ">=6.16.1",
    "@xmldom/xmldom": ">=0.9.12",
    "handlebars": "^4.7.10",
    "@vitest/mocker": ">=4.1.12",
    "follow-redirects": ">=1.16.1",
    "fast-jwt": ">=6.3.4",
    "shell-quote": ">=1.11.0",
    "source-map-js": ">=1.2.2",
    "ip-address": ">=10.7.1",
    "pbkdf2": ">=3.1.7",
    "joi": ">=18.3.1",
    "glob": ">=14.0.2",
    "minimatch": ">=11.0.1",
    "node-fetch": ">=3.3.2",
    "node-forge": ">=1.3.1",
    "node-html-parser": ">=6.1.5",
    "node-sass": ">=9.0.0",
    "node-sass-chokidar": ">=1.5.0",
    "node-sass-tilde-importer": ">=1.1.2",
    "node-sass-utils": ">=1.7.0",
    "node-sass-middleware": ">=1.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ]
  }
}
