{
  "name": "atlas-logistics",
  "version": "1.0.0",
  "description": "SCM Freight Forwarding MVP",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:dashboard": "pnpm --filter @atlas/dashboard dev",
    "build": "turbo run build",
    "lint": "pnpm run eslint",
    "test": "pnpm --filter @atlas/shared test",
    "type-check": "pnpm --filter @atlas/frontend type-check",
    "eslint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "sh .devcontainer/reset-db.sh",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset-and-seed": "sh .devcontainer/reset-db.sh && tsx src/db/seed.ts",
    "start:backend": "tsx --env-file=.env.local src/server.ts | pino-pretty",
    "start:worker": "tsx --env-file=.env.local src/worker-node.ts | pino-pretty",
    "test:e2e": "playwright test",
    "admin:create": "tsx src/admin/cli.ts",
    "clean:cache": "rm -rf .turbo .njsscan",
    "backup-db": "node src/scripts/backup-db.js"
  },
  "dependencies": {
    "@atlas/shared": "workspace:^",
    "@bull-board/api": "^8.6.1",
    "@bull-board/fastify": "^8.6.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^8.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/storage": "^6.12.0",
    "@google/genai": "^2.16.0",
    "@libsql/client": "^0.17.4",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bpmn-auto-layout": "^1.3.0",
    "bullmq": "^6.1.0",
    "csv-parser": "^3.2.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.11.3",
    "fastify-metrics": "^13.2.1",
    "framer-motion": "^13.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucia": "^3.2.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "oslo": "^1.2.1",
    "p-limit": "^7.3.1",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "prom-client": "^15.0.0",
    "sax": "^1.6.1",
    "tsx": "^4.23.12",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@faker-js/faker": "^10.5.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@originjs/vite-plugin-federation": "^1.3.8",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sax": "^1.2.7",
    "@types/supertest": "^7.2.1",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "cross-fetch": "^4.1.0",
    "d3-color": "^3.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-workspaces": "^0.12.1",
    "fast-uri": "^4.1.2",
    "husky": "^9.1.7",
    "i18next": "^26.3.6",
    "ioredis-mock": "^8.13.1",
    "lint-staged": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "semantic-release": "^25.0.8",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "uuid": "^14.0.0",
    "vite": "^8.1.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.9",
      "react-router": "^8.3.0",
      "valibot": "^1.4.2",
      "uuid": "^14.0.0",
      "esbuild": "^0.25.0",
      "nanoid": ">=3.3.17",
      "js-yaml": ">=4.3.1",
      "dompurify": ">=3.4.13",
      "undici@^6.0.0": "^6.28.0",
      "undici@^7.0.0": "^7.29.0",
      "fast-uri@^3.0.0": "^3.1.5",
      "fast-uri@^4.0.0": "^4.1.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-14257",
        "GHSA-mh99-v99m-4gvg",
        "GHSA-qwww-vcr4-c8h2",
        "GHSA-5p4m-2wfm-xmqj",
        "GHSA-2v37-7h3g-55p8",
        "GHSA-4cwx-7wf7-3272",
        "GHSA-7p8r-x3mc-p8w7",
        "CVE-2026-59870",
        "GHSA-8xcm-r25x-g524",
        "GHSA-m8rv-5g2x-5cg5",
        "GHSA-jr45-8vmc-qm54",
        "GHSA-v3r7-h72x-cjcm",
        "GHSA-55q2-fjhq-7xh7",
        "GHSA-848j-6mx2-7j84"
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ]
  }
}
