# ==============================================================================
# ATLAS LOGISTICS — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Usage for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - .env.local is ignored by Git and never committed.
# - Only active variables used by the Fastify + SQLite + Vite stack are listed here.
# ==============================================================================

# 1. Runtime & Logging
NODE_ENV=development
LOG_LEVEL=info

# 2. Relational Database (SQLite WAL mode via Drizzle ORM / libSQL)
DATABASE_URL=file:./data/dev.db

# 3. Server & Frontend Ports
BACKEND_PORT=3001
VITE_PORT=5173
VITE_API_URL=http://localhost:3001

# 4. Authentication & Session Security (Minimum 32 characters)
JWT_SECRET=your-jwt-secret-minimum-32-characters-change-me
COOKIE_SECRET=your-cookie-secret-minimum-32-characters-change-me

# 5. Google AI Studio — Gemini API (Free-Tier On-Demand Gateway)
# Generate a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash

# 6. Optional: Redis Queue (Leave unset in local dev to use built-in in-memory mock)
# REDIS_URL=redis://127.0.0.1:6379
