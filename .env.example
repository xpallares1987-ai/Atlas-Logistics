# ==============================================================================
# ATLAS LOGISTICS — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Usage for local development:
#   cp .env.example .env.local
#
# RULES OF THUMB (3 STRICT BUCKETS — NEVER MIX):
# 1. PUBLIC FRONTEND (VITE_*): Bundled in plaintext into browser JS. NEVER put
#    secrets here. Configure in Vercel (Production SPA) / GitHub Pages build.
# 2. BACKEND CONFIG (Non-Secret): Runtime settings, ports, DB URI. Configure in
#    .env.local (local dev) or Cloud Run env vars (production). NEVER in Vercel.
# 3. BACKEND SECRETS (ENCRYPTED): Tokens, signing keys, API keys, webhook URLs.
#    Store in .env.local (gitignored) or Cloud Run Secret Manager. NEVER in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (VITE_* — Plaintext in browser, Vercel SPA)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Non-Secret — .env.local / Cloud Run Env)
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=file:./data/dev.db
BACKEND_PORT=3001
FRONTEND_PORT=5173
GEMINI_MODEL=gemini-2.5-flash

# Optional: Redis Queue (Leave unset in local dev to use built-in in-memory mock)
# REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 3. BACKEND SECRETS (SENSITIVE — Encrypt in Cloud Run Secret Manager; NEVER Vercel)
# ------------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-minimum-32-characters-change-me
COOKIE_SECRET=your-cookie-secret-minimum-32-characters-change-me
GEMINI_API_KEY=your-google-ai-studio-api-key

# Optional: Comma-separated Microsoft Teams / Logic Apps HTTPS webhook URLs (SSRF guard)
TEAMS_WEBHOOK_ALLOWLIST=
