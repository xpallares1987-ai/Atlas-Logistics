{
  "npm.packageManager": "pnpm",
  "npm-intellisense.packageSubfoldersIntellisense": true,
  "npm-intellisense.scanDevDependencies": true,
  "npm-intellisense.showBuildInLibs": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "tailwindCSS.experimental.classRegex": [
    [ "cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]" ]
  ],
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.mouseWheelZoom": true,
  "editor.codeActions.triggerOnFocusChange": true,
  "gemini-cli.debug.logging.enabled": true,
  "gemini-cli.executablePath": "C:\\Users\\xpall\\AppData\\Local\\agy\\bin\\agy.exe",
  "gemini-cli.port": 3000,
  "docker.languageserver.formatter.ignoreMultilineInstructions": true,
  "containers.truncateLongRegistryPaths": true,
  "containers.contexts.showInStatusBar": true,
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
  "git.verboseCommit": true,
  "git.useCommitInputAsStashMessage": true,
  "git.timeline.showUncommitted": true,
  "git.supportCancellation": true,
  "git.replaceTagsWhenPull": true,
  "git.rebaseWhenSync": true,
  "git.pruneOnFetch": true,
  "git.mergeEditor": true,
  "git.inputValidation": true,
  "git.autoStash": true,
  "git.addAICoAuthor": "chatAndAgent",
  "chat.agent.sandbox.network.allowLocalNetwork": true,
  "chat.checkpoints.showFileChanges": true,
  "chat.editor.fontSize": 11,
  "chat.editor.wordWrap": "on",
  "chat.fontSize": 11,
  "chat.editing.explainChanges.enabled": true,
  "chat.unifiedAgentsBar.enabled": true,
  "chat.restoreLastPanelSession": true,
  "chat.viewProgressBadge.enabled": true,
  "chat.exitAfterDelegation": true,
  "chat.agentSessionProjection.enabled": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
  "chat.tools.terminal.outputDeltas": true,
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "cursor-workspace": true,
    "windsurf": true,
    "cursor-global": true
  },
  "chat.mcp.gallery.enabled": true,
  "chat.mcp.assisted.nuget.enabled": true,
  "chat.includeReferencedInstructions": true,
  "chat.experimental.useSkillAdherencePrompt": true,
  "chat.useNestedAgentsMdFiles": true,
  "inlineChat.defaultModel": "Gemini 3.8 Flash (gemini)",
  "inlineChat.affordance": "editor",
  "inlineChat.notebookAgent": true,
  "chat.disableAIFeatures": false
}
