{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "🔴 Attach to Fastify Backend",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "outputCapture": "console",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "preLaunchTask": "",
      "presentation": {
        "hidden": false,
        "group": "Atlas Development",
        "order": 1
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🟢 Launch Fastify (Debug Mode)",
      "program": "${workspaceFolder}/src/server.ts",
      "runtimeArgs": ["--loader", "tsx/esm"],
      "args": [],
      "env": {
        "NODE_ENV": "development",
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "hidden": false,
        "group": "Atlas Development",
        "order": 2
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🟡 Launch Worker (Debug Mode)",
      "program": "${workspaceFolder}/src/worker-node.ts",
      "runtimeArgs": ["--loader", "tsx/esm"],
      "args": [],
      "env": {
        "NODE_ENV": "development",
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "hidden": false,
        "group": "Atlas Development",
        "order": 3
      }
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full Stack Debug (Fastify + Vite)",
      "configurations": [
        "🔴 Attach to Fastify Backend"
      ],
      "presentation": {
        "hidden": false,
        "group": "Atlas Development",
        "order": 0
      }
    }
  ]
}
