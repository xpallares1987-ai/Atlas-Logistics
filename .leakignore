node_modules/
dist/
dev-dist/
coverage/
.turbo/
.cache/
backups/
backups-test/
.pnpm-store/
pnpm-lock.yaml
package-lock.json

# Internal audit reports and verification scripts
audit-results.json
scratch/
*.patch
*.diff
full_diff.patch
