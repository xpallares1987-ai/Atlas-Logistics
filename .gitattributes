# Set default behavior to automatically handle line endings and enforce LF in repository
* text=auto eol=lf

# Explicit text file types enforced to LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.txt text eol=lf

# Windows and PowerShell batch/script files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Binary files - preserve exact bytes
*.db binary
*.sqlite binary
*.sqlite3 binary
*.wal binary
*.shm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
